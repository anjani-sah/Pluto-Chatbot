def control_device(device, state):
    """Publish IoT device control via MQTT"""
    global mqtt_client, MQTT_CONNECTED
    
    # Check if MQTT is available
    if not mqtt_client or not MQTT_CONNECTED:
        print("❌ MQTT not connected - cannot control devices")
        return False
        
    topic = None
    if device == "light":
        topic = MQTT_TOPIC_LIGHT
    elif device == "fan":
        topic = MQTT_TOPIC_FAN

    if topic:
        try:
            # Publish with QoS 1 for reliability
            result = mqtt_client.publish(topic, state, qos=1, retain=True)
            
            if result.rc == mqtt.MQTT_ERR_SUCCESS:
                print(f"✅ MQTT → {topic}: {state}")
                return True
            else:
                print(f"❌ MQTT publish failed: {result.rc}")
                return False
                
        except Exception as e:
            print(f"❌ MQTT publish error: {e}")
            return False
    else:
        print(f"❌ Unknown device: {device}")
        return False

