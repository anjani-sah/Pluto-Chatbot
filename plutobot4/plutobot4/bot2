# Platform detection and optimization
IS_RASPBERRY_PI = False
AUDIO_SYSTEM = "unknown"

def detect_platform():
    """Detect if running on Raspberry Pi and what audio system is used"""
    global IS_RASPBERRY_PI, AUDIO_SYSTEM
    
    try:
        # Check if running on Raspberry Pi
        with open('/proc/device-tree/model', 'r') as f:
            model = f.read()
            if 'Raspberry Pi' in model:
                IS_RASPBERRY_PI = True
                print(f"🔧 Running on {model.strip()}")
            else:
                IS_RASPBERRY_PI = False
    except:
        # Check CPU architecture as fallback
        machine = platform.machine().lower()
        IS_RASPBERRY_PI = 'arm' in machine
        if IS_RASPBERRY_PI:
            print(f"🔧 Running on ARM architecture: {machine}")
        else:
            print(f"🔧 Running on {platform.system()} {machine}")
    
    # Detect audio system
    if IS_RASPBERRY_PI:
        try:
            # Check for PipeWire (Pi 5 default)
            result = subprocess.run(['systemctl', '--user', 'is-active', 'pipewire'], 
                                  capture_output=True, text=True, timeout=2)
            if result.returncode == 0:
                AUDIO_SYSTEM = "pipewire"
            else:
                # Check for PulseAudio
                result = subprocess.run(['pulseaudio', '--check'], 
                                      capture_output=True, timeout=2)
                if result.returncode == 0:
                    AUDIO_SYSTEM = "pulseaudio"
                else:
                    AUDIO_SYSTEM = "alsa"
        except:
            AUDIO_SYSTEM = "alsa"
        
        print(f"🔧 Audio system detected: {AUDIO_SYSTEM}")
    else:
        AUDIO_SYSTEM = "default"

