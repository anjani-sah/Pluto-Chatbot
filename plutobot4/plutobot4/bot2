def convert_audio_to_16k_pcm(mic_audio):
    raw = mic_audio.get_raw_data(convert_rate=SAMPLE_RATE, convert_width=2)
    return raw

def frame_generator(raw_bytes, frame_ms=FRAME_DURATION_MS, sample_rate=SAMPLE_RATE):
    bytes_per_frame = int(sample_rate * 2 * frame_ms / 1000)
    for i in range(0, len(raw_bytes), bytes_per_frame):
        chunk = raw_bytes[i:i+bytes_per_frame]
        if len(chunk) == bytes_per_frame:
            yield chunk

def speech_ratio(raw_bytes):
    frames = list(frame_generator(raw_bytes))
    if not frames:
        return 0
    voiced = 0
    for f in frames:
        if vad.is_speech(f, SAMPLE_RATE):
            voiced += 1
    return voiced / len(frames)

# Helper: build sr.AudioData from raw mono 16-bit PCM bytes
def build_audio_data(raw_bytes):
    return sr.AudioData(raw_bytes, SAMPLE_RATE, 2)

