def is_search_intent(q: str):
    ql = q.lower().strip()
    starters = [
        "search", "search for", "search on", "search on web", "search on the web",
        "look up", "google", "google for", "search up"
    ]
    if any(ql.startswith(s) for s in starters):
        return True
    return " search " in f" {ql} " or ql.startswith("search")

def extract_search_query(raw: str):
    q = raw.lower().strip()
    prefixes = [
        "search for ", "search up ", "search on the web for ", "search on the web ",
        "search on web for ", "search on web ", "search on ", "search ",
        "look up ", "google for ", "google "
    ]
    changed = True
    while changed:
        changed = False
        for p in prefixes:
            if q.startswith(p):
                q = q[len(p):]
                changed = True
    return q.strip()

def google_search(query: str, max_results=3):
    if not GOOGLE_SEARCH_API_KEY or not GOOGLE_CSE_ID or GOOGLE_CSE_ID.startswith("PUT_"):
        return "Google search not configured (set GOOGLE_CSE_ID)."
    try:
        resp = requests.get(
            "https://www.googleapis.com/customsearch/v1",
            params={
                "key": GOOGLE_SEARCH_API_KEY,
                "cx": GOOGLE_CSE_ID,
                "q": query,
                "num": max_results,
                "safe": "active"
            },
            timeout=6
        )
        data = resp.json()
        items = data.get("items") or []
        if not items:
            return "No results found."
        summaries = []
        for it in items[:max_results]:
            title = it.get("title", "")
            snippet = (it.get("snippet") or "").replace("\n", " ").strip()
            summaries.append(f"{title}: {snippet}")
        joined = " | ".join(summaries)
        if len(joined) > 350:
            try:
                msgs = [
                    {"role": "system", "content": "Summarize search results in <=55 casual words."},
                    {"role": "user", "content": joined}
                ]
                return get_completion(msgs)
            except Exception:
                return joined[:350]
        return joined
    except Exception as e:
        return f"Search failed: {e}"

