    def _find_best_input_device(self):
        """Find the best audio input device"""
        try:
            default_device = self._pa.get_default_input_device_info()
            debug_print(f"🎤 Using default input: {default_device['name']}")
            return default_device['index']
        except:
            # If we can't get default, try to find USB microphone on Pi
            if IS_RASPBERRY_PI:
                try:
                    device_count = self._pa.get_device_count()
                    for i in range(device_count):
                        device_info = self._pa.get_device_info_by_index(i)
                        if (device_info['maxInputChannels'] > 0 and 
                            ('usb' in device_info['name'].lower() or 
                             'microphone' in device_info['name'].lower())):
                            debug_print(f"🎤 Found USB mic: {device_info['name']}")
                            return i
                except:
                    pass
            return None  # Use system default

    # Backwards compatibility with run() naming
    def start_listener(self):
        self.start_streaming()

    def stop_listener(self):
