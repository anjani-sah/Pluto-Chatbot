# Variants that count as the real name for conversational follow-up (includes bluetooth and ludo)
REAL_PLUTO_VARIANTS = [
    "pluto","plueto","plutto","plutoo","plut","ploot","pluda","pludo","plu",
    "bluto","cluto","fluto","plutho","plutoh","plutor","plutwo","plutoe","plutah",
    "plutone","plutow","plutuh","pluto's","ploodle","plutooo","pluo","plue","pluohto",
    "pluhto","plutoa","plutov","pludi","pluty","ploodo","ludo","blue toe","blue two","blue too","blue tow",
    # Bluetooth variants (comprehensive mishearings) - now included for conversation
    "bluetooth","bluetoot","bluetooh","bluetoooth","bluetoth","bluetoof",
    "blutooth","blutoot","blutu","blueto","blueth","blooth","blutoth",
    "blue tooth","blue toof","blue toth","bluetof","blueooth","bluetothe"
]

FILLER_PREFIXES = ["hey", "hi", "yo", "okay", "ok", "oi", "alright", "bro", "dude"]

CASUAL_GREETINGS = [
    "what's up", "whats up", "sup", "you there", "are you there", "are you awake",
    "how are you", "how's it going", "hows it going", "how you doing", "how are ya",
    "yo", "hey", "hi", "hello"
]

def _contains_real_pluto(text: str) -> bool:
    t = text.lower()
    for v in REAL_PLUTO_VARIANTS:
        if v in t:
            return True
    return False

# Build regex to strip Pluto name variants (now includes 'ludo')
_name_pattern = re.compile(r"\b(" + "|".join(sorted(set(v for v in REAL_PLUTO_VARIANTS if " " not in v), key=len, reverse=True)) + r")'?s?\b")
_phrase_variants = [v for v in REAL_PLUTO_VARIANTS if " " in v]

def clean_passive_command(original: str) -> str | None:
    """Return cleaned text with Pluto's name + filler removed.
    Returns None only if no recognized Pluto variants are found.
    """
    if not original or not original.strip():
        return None
        
    low = original.lower().strip()
    original_low = low  # Keep for debugging
    
    # Check if we found any real conversation triggers (not just wake-only words)
    if not _contains_real_pluto(low):
        debug_print(f"No real conversation variants found in: '{original_low}'")
        return None
    
    # Remove phrase variants first
    for pv in _phrase_variants:
        if pv in low:
            low = low.replace(pv, " ")
    
    # Remove single-word variants using regex
    low = _name_pattern.sub(" ", low)
    
    # Remove filler prefixes repeatedly
    changed = True
    iterations = 0
    while changed and iterations < 5:  # Prevent infinite loops
        changed = False
        iterations += 1
        for fp in FILLER_PREFIXES:
            pattern = rf"^\s*{re.escape(fp)}[ ,!?]*"
            new_low = re.sub(pattern, " ", low)
            if new_low != low:
                low = new_low
                changed = True
    
    # Collapse whitespace & clean punctuation
    low = re.sub(r"[ ]+", " ", low)
    low = low.strip(" ,.!?\t\n")
    
    result = low.strip()
    debug_print(f"Cleaned '{original_low}' -> '{result}'")
    
    # Return empty string instead of None for empty results (let caller handle)
    return result if result else ""

def is_casual_greeting(text: str) -> bool:
    t = text.lower().strip()
    if not t:
        return True
    
    # Only match pure greetings, not commands that contain greetings
    # First, check if this is ONLY a greeting (no other content)
    words = t.split()
    if len(words) == 1 and words[0] in ["hi", "hello", "hey", "yo", "sup", "wassup"]:
        return True
    
    # For 2-word cases, only match if both words are greeting-related
    if len(words) == 2:
        greeting_words = ["hi", "hello", "hey", "yo", "there", "sup", "wassup"]
        if all(word in greeting_words for word in words):
            return True
    
    # Don't treat longer phrases as greetings - they likely contain commands
    return False

