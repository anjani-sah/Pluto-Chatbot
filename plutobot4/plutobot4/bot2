def get_weather(location: str | None):
    loc = (location or "mumbai").strip()
    if not loc:
        loc = "mumbai"
    try:
        resp = requests.get(f"https://wttr.in/{loc}?format=j1", timeout=6)
        data = resp.json()
        cur = data['current_condition'][0]
        desc = cur['weatherDesc'][0]['value']
        temp = cur['temp_C']
        feels = cur['FeelsLikeC']
        humidity = cur.get('humidity')
        return f"{loc} {temp}C feels {feels}C, {desc}, humidity {humidity}%."
    except Exception as e:
        return f"Weather lookup failed: {e}"

# Helper: extract weather intent & location from a query
def detect_weather_query(q: str):
    ql = q.lower().strip()
    weather_tokens = ["weather", "temperature", "temp"]
    if any(ql.startswith(t) for t in weather_tokens) or " weather " in f" {ql} ":
        # location patterns
        loc = None
        if " in " in ql:
            loc = ql.split(" in ", 1)[1].strip()
        else:
            parts = ql.split()
            if len(parts) > 1:
                # remove first token (intent word)
                loc = " ".join(parts[1:]).strip()
        return True, loc
    return False, None

