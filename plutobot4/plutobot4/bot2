# Pre-compiled regex patterns for faster matching
REMEMBER_PATTERNS = [
    re.compile(r"^remember my (favorite|fav) (\w+) is (.+)$"),
    re.compile(r"^remember that my (favorite|fav) (\w+) is (.+)$"),
    re.compile(r"^my (favorite|fav) (\w+) is (.+)$"),
    re.compile(r"^set my (favorite|fav) (\w+) to (.+)$")
]

ASK_PATTERNS = [
    re.compile(r"^what'?s my (favorite|fav) (\w+)[?]?$"),
    re.compile(r"^what is my (favorite|fav) (\w+)[?]?$"),
    re.compile(r"^do you remember my (favorite|fav) (\w+)[?]?$"),
]

def parse_remember_intent(text: str):
    tl = text.lower().strip()
    for pat in REMEMBER_PATTERNS:
        m = pat.match(tl)  # Use pre-compiled pattern
        if m:
            cat = m.group(2)
            val = m.group(3).strip().strip('.! ') if len(m.groups()) >= 3 else None
            key = PREFERENCE_CATEGORIES.get(cat)
            if key and val:
                return key, val
    return None, None

def parse_recall_intent(text: str):
    tl = text.lower().strip()
    for pat in ASK_PATTERNS:
        m = pat.match(tl)  # Use pre-compiled pattern
        if m:
            cat = m.group(2)
            key = PREFERENCE_CATEGORIES.get(cat)
            if key:
                return key
    # Broad queries like "what do you remember about me" / "what do you know about me"
    if any(p in tl for p in ["what do you remember about me", "what do you know about me", "what do you remember", "what all do you remember about me"]):
        return "__list_all__"
    return None

