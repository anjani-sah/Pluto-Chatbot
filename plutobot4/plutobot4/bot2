def parse_eye_status(status_msg):
    """Parse status messages from ESP32"""
    try:
        # Example: "STATUS:awake,mode:normal,attention:50,face:detected,tracking:enabled"
        parts = status_msg.replace("STATUS:", "").split(",")
        status_dict = {}
        
        for part in parts:
            if ":" in part:
                key, value = part.split(":", 1)
                status_dict[key] = value
        
        debug_print(f"👁️  Eye status: {status_dict}")
        return status_dict
    except Exception as e:
        debug_print(f"Error parsing eye status: {e}")
        return {}

