        print(f"   Error codes: 0=success, 1=protocol, 2=client_id, 3=server_unavailable, 4=bad_user/pass, 5=not_authorized")

def on_mqtt_disconnect(client, userdata, rc, properties=None):
    """Callback for MQTT disconnection"""
    global MQTT_CONNECTED
    MQTT_CONNECTED = False
    if rc != 0:
        print(f"⚠️  MQTT broker unexpectedly disconnected (code: {rc})")
    else:
        print("📡 MQTT broker disconnected normally")

def on_mqtt_message(client, userdata, msg):
    """Callback for incoming MQTT messages"""
    try:
        topic = msg.topic
        message = msg.payload.decode()
        print(f"📡 MQTT received: {topic} = {message}")
        
        # Handle status updates from devices
        if topic.endswith("/status"):
            device_name = topic.split("/")[1]  # Extract device name from topic
            print(f"📊 Device {device_name} status: {message}")
            
    except Exception as e:
        print(f"❌ Error processing MQTT message: {e}")

def setup_mqtt():
    """Initialize MQTT client with proper configuration"""
    global mqtt_client, MQTT_CONNECTED
    
    try:
        # Create MQTT client with callbacks
        mqtt_client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id="pluto_bot")
        mqtt_client.on_connect = on_mqtt_connect
        mqtt_client.on_disconnect = on_mqtt_disconnect
        mqtt_client.on_message = on_mqtt_message
        
        # Set connection parameters
        mqtt_client.reconnect_delay_set(min_delay=1, max_delay=120)
        
        print(f"🔌 Attempting MQTT connection to {MQTT_BROKER}:{MQTT_PORT}")
        
        # Connect to broker
        mqtt_client.connect(MQTT_BROKER, MQTT_PORT, 60)
        
        # Start the loop in background thread
        mqtt_client.loop_start()
        
        # Reduced wait time from 2 to 1 second for faster startup
        time.sleep(1)
        
        if MQTT_CONNECTED:
            print("✅ MQTT setup complete")
        else:
            print("⚠️  MQTT connection pending...")
            
    except Exception as e:
        print(f"❌ MQTT setup failed: {e}")
        print("🔧 Make sure Mosquitto is installed and running:")
        print("   sudo apt install mosquitto mosquitto-clients")
        print("   sudo systemctl start mosquitto")
