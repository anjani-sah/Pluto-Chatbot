def is_pluto_trigger(text):
    if not text:
        return False
    raw = text.lower()
    compact = raw.replace(" ", "")
    # Expanded + phonetic / mishearing variants
    candidates = [
        "pluto","plueto","plutto","plutoo","plut","ploot","pluda","pludo","plu",
        "bluto","cluto","fluto","plutho","plutoh","plutor","plutwo","plutoe","plutah",
        "plutone","plutow","plutuh","pluto's","ploodle","plutoo","plutooo","pluo","plue",
        "pluohto","pluhto","plutoa","plutov","pludi","pluty","ploodo","ludo",  # added ludo variant
        # New phrase style mis-hearings
        "blue toe","blue two","blue too","blue tow",
        # Bluetooth variants (comprehensive mishearings)
        "bluetooth","bluetoot","bluetooh","bluetoooth","bluetoth","bluetoof",
        "blutooth","blutoot","blutu","blueto","blueth","blooth","blutoth",
        "blue tooth","blue toof","blue toth","bluetof","blueooth","bluetothe"
    ]
    # Early heuristic startswith for partials / common confusions
    if compact.startswith(("pl","blu","clu","lud","blt","bt")):
        return True
    # Fast substring check
    if "plu" in compact or compact.startswith("plut") or "ludo" in compact or "blueto" in compact or "bluetooth" in compact or "bluetoo" in compact:
        return True
    for cand in candidates:
        if " " in cand:
            # phrase candidate – check raw text directly
            if cand in raw:
                return True
        else:
            if cand in compact:
                return True
    # Fuzzy thresholds (relaxed)
    for cand in candidates:
        # Lowered thresholds: ratio 60, partial 80
        if fuzz.ratio(raw, cand) >= 60 or fuzz.partial_ratio(raw, cand) >= 80:
            return True
    return False

def is_hello_pluto_trigger(text, threshold=60):
    return is_phonetic_match(text, "hello pluto", threshold)

