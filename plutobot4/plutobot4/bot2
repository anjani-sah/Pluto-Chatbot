def get_tts_cache_path(text, voice=None):
    """Get cache path for TTS with voice-specific caching"""
    cache_dir = "tts_cache"
    os.makedirs(cache_dir, exist_ok=True)
    
    # Include voice in cache key to avoid conflicts between different voices
    voice_to_use = voice or CURRENT_VOICE
    cache_key = f"{text.strip().lower()}_{voice_to_use}"
    text_hash = hashlib.md5(cache_key.encode('utf-8')).hexdigest()
    return os.path.join(cache_dir, f"{text_hash}.mp3")

# -------------------------
# OpenAI TTS
# -------------------------
def speak_text(text, preload_only=False, voice=None):
    global playback_interrupted
    voice_to_use = voice or CURRENT_VOICE
    cache_path = get_tts_cache_path(text, voice_to_use)
    if os.path.exists(cache_path):
        if not preload_only:
            play_audio(cache_path)
        return

    try:
        with client.audio.speech.with_streaming_response.create(
            model="gpt-4o-mini-tts",  
            voice=voice_to_use,  # Use the specified voice
            input=text,
            speed=1.02 
        ) as resp:
            with open(cache_path, "wb") as f:
                for chunk in resp.iter_bytes():
                    f.write(chunk)
        
        if not preload_only:
            play_audio(cache_path)
    except Exception as e:
        if not preload_only:
            print(f"TTS generation failed: {e}")

