    def start_streaming(self):
        if self.listener_thread and self.listener_thread.is_alive():
            return
        if not self._init_pyaudio():
            print("Streaming unavailable")
            return
            
        # Set eyes to listening mode when starting to stream
        set_eye_listening_mode()
        
        # Clear queues on restart to avoid stale data
        self.clear_old_inputs(keep_latest=False)
        self.clear_stale_audio_segments()
        debug_print("⚡ Cleared queues for fresh start")
        
        # Log initial queue status
        self.log_queue_status()
        
        self.stop_signal.clear()
        self.listener_thread = threading.Thread(target=self.streaming_loop, name="audio_stream_thread", daemon=True)
        self.listener_thread.start()
        self.recog_thread = threading.Thread(target=self.recognition_worker, name="recognition_thread", daemon=True)
        self.recog_thread.start()

    def stop_streaming(self):
        self.stop_signal.set()
        if self.listener_thread:
            self.listener_thread.join(timeout=1)
        if self.recog_thread:
            self.recog_thread.join(timeout=1)
        self.listener_thread = None
        self.recog_thread = None
        try:
            if self._stream:
                self._stream.stop_stream()
                self._stream.close()
        except Exception:
            pass
        self._stream = None
        try:
            if self._pa:
                self._pa.terminate()
        except Exception:
            pass
        self._pa = None

    # --------------- Streaming Producer ---------------
    def streaming_loop(self):
        print("[stream] ultra-responsive streaming started")
        pre_roll = collections.deque(maxlen=PRE_ROLL_FRAMES)
        triggered = False
        voiced_run = 0
        silence_run = 0
        current_segment = []  # list of frame bytes
        frames_in_segment = 0
        frame_count = 0  # For periodic monitoring
        
        while not self.stop_signal.is_set():
            try:
                # Smaller frame read for lower latency
                frame_size = int(SAMPLE_RATE * STREAM_FRAME_MS / 1000)
                frame = self._stream.read(frame_size, exception_on_overflow=False)
                frame_count += 1
                
                # Periodic queue monitoring (every 1000 frames ~20 seconds)
                if frame_count % 1000 == 0:
                    self.log_queue_status()
                    
            except Exception:
                # Reduced from 0.005 to 0.001 for faster audio recovery
                time.sleep(0.001)
                continue
            is_speech = False
            try:
                is_speech = vad.is_speech(frame, SAMPLE_RATE)
            except Exception:
                # corrupt frame; skip
                continue

            if not triggered:
                pre_roll.append(frame)
                if is_speech:
                    voiced_run += 1
                else:
                    voiced_run = 0
                if voiced_run >= ACTIVATION_SPEECH_FRAMES:
                    triggered = True
                    current_segment.extend(pre_roll)
                    frames_in_segment = len(pre_roll)
                    silence_run = 0
                    voiced_run = 0
            else:
                current_segment.append(frame)
                frames_in_segment += 1
                if is_speech:
                    silence_run = 0
                else:
                    silence_run += 1

                # End conditions
                if silence_run >= END_SILENCE_FRAMES or frames_in_segment >= MAX_SEGMENT_FRAMES:
                    # finalize segment
                    if frames_in_segment >= MIN_SEGMENT_FRAMES:
                        segment_bytes = b''.join(current_segment)
                        try:
                            with self.segment_queue_lock:
                                try:
                                    self.segment_queue.put_nowait(segment_bytes)
                                except queue.Full:
                                    # Aggressively replace old segments with better error handling
                                    segments_cleared = 0
                                    try:
                                        # Clear multiple old segments for faster processing
                                        for _ in range(3):
                                            self.segment_queue.get_nowait()
                                            segments_cleared += 1
                                        self.segment_queue.put_nowait(segment_bytes)
                                        debug_print(f"⚡ Ultra-fast: cleared {segments_cleared} old segments for new one")
                                    except queue.Empty:
                                        debug_print("⚠️  Segment queue empty during cleanup")
                                    except Exception as e:
                                        debug_print(f"Error handling full segment queue: {e}")
                        except Exception as e:
                            debug_print(f"Error adding segment to queue: {e}")
                    # reset
                    triggered = False
                    current_segment = []
                    frames_in_segment = 0
                    silence_run = 0
                    pre_roll.clear()
            # No yield needed - CPU optimization for faster processing
        print("[stream] stopped")

    # --------------- Recognition Consumer ---------------
    def recognition_worker(self):
        print("[recog] worker started")
        timeout_count = 0
        while not self.stop_signal.is_set():
            try:
                # Reduced timeout from 0.15 to 0.1 for ultra-fast processing
                segment = self.segment_queue.get(timeout=0.1)
            except queue.Empty:
                continue
            duration_sec = len(segment) / (2 * SAMPLE_RATE)
            if duration_sec > (MAX_SEGMENT_MS / 1000.0 + 0.25):
                max_bytes = int((MAX_SEGMENT_MS / 1000.0) * SAMPLE_RATE * 2)
                segment = segment[:max_bytes]
                duration_sec = len(segment) / (2 * SAMPLE_RATE)
            audio_data = build_audio_data(segment)
            try:
                text = r.recognize_google(audio_data).lower()
            except (sr.UnknownValueError, sr.RequestError):
                continue
            except (TimeoutError, socket.timeout) as e:
                timeout_count += 1
                if timeout_count % 5 == 1:
                    print(f"[recog] network timeout (count={timeout_count})")
                continue
            except Exception as e:
                print(f"[recog] unexpected error: {e}")
                continue
            if not text:
                continue
            collapsed = text.replace(" ", "")
            # Optimized trigger token matching with sets for O(1) lookup
            phrase_tokens = {"blue toe", "blue two", "blue too", "blue tow"}
            word_tokens = {"plu", "ploo", "plue", "pluto", "plutto", "plutoo", "bluto", "cluto", "ludo"}
            
            matched = False
            # Check phrase tokens in original text
            for tok in phrase_tokens:
                if tok in text:
                    matched = True
                    break
            
            # Check word tokens in collapsed text if not already matched
            if not matched:
                for tok in word_tokens:
                    if tok in collapsed:
                        matched = True
                        break
            if matched or is_pluto_trigger(text):
                # Clear old inputs when new wake word detected
                self.clear_old_inputs(keep_latest=False)
                
                try:
                    with self.input_queue_lock:
                        try:
                            self.input_queue.put_nowait(text)
                        except queue.Full:
                            # If queue is full, clear it and try again
                            debug_print("Input queue full, clearing and retrying...")
                            self.clear_old_inputs(keep_latest=False)
                            try:
                                self.input_queue.put_nowait(text)
                            except queue.Full:
                                debug_print("⚠️  Still couldn't add input after clearing")
                    
                    global playback_interrupted
                    playback_interrupted = True
                    print(f"[recog] accepted: {text}")
                except Exception as e:
                    debug_print(f"Error adding input to queue: {e}")
        print("[recog] worker stopped")

    # --------------- TTS & Interrupt ---------------
    def speak_and_interrupt(self, text):
        global playback_interrupted
        self.speaking.set()
        playback_interrupted = False
        
        # Set eyes to speaking mode
        set_eye_speaking_mode()
        
        # Instantly clear all pending audio
        self.clear_stale_audio_segments()
        
        # For ultra-fast responses, check if it's a short response
        if text in ULTRA_FAST_RESPONSES.values():
            # Pre-cached ultra-short responses
            cache_path = get_tts_cache_path(text, CURRENT_VOICE)
            if os.path.exists(cache_path):
                play_audio(cache_path)
                self.speaking.clear()
                return
        
        speak_thread = threading.Thread(target=speak_text, args=(text,))
        speak_thread.start()
        while speak_thread.is_alive():
            if not self.input_queue.empty():
                playback_interrupted = True
                self.speaking.clear()
                break
            # Reduced from 0.005 to 0.001 for ultra-fast interrupt response
            time.sleep(0.001)
        speak_thread.join()
        self.speaking.clear()

    # --------------- Queue Management for Speed ---------------
    def get_queue_status(self):
        """Get current queue status for debugging"""
        try:
            input_size = self.input_queue.qsize()
            segment_size = self.segment_queue.qsize()
            
            # Get actual queue max sizes
            input_max = self.input_queue.maxsize
            segment_max = self.segment_queue.maxsize
            
            return {
                'input_queue_size': input_size,
                'segment_queue_size': segment_size,
                'input_queue_max': input_max,
                'segment_queue_max': segment_max,
                'total_segments_cleared': self.total_segments_cleared,
                'total_inputs_cleared': self.total_inputs_cleared,
                'input_queue_full': input_size >= input_max * 0.9,  # 90% full warning
                'segment_queue_full': segment_size >= segment_max * 0.9
            }
        except Exception as e:
            debug_print(f"Error getting queue status: {e}")
            return {'error': str(e)}

    def log_queue_status(self):
        """Log current queue status if DEBUG_MODE is enabled"""
        if DEBUG_MODE:
            status = self.get_queue_status()
            if 'error' not in status:
                debug_print(f"📊 Queue Status - Input: {status['input_queue_size']}/{status['input_queue_max']}, "
                          f"Segments: {status['segment_queue_size']}/{status['segment_queue_max']}, "
                          f"Cleared: {status['total_inputs_cleared']} inputs, "
                          f"{status['total_segments_cleared']} segments")
                
                # Warn about nearly full queues
                if status['input_queue_full']:
                    debug_print("⚠️  Input queue is nearly full!")
                if status['segment_queue_full']:
                    debug_print("⚠️  Segment queue is nearly full!")

