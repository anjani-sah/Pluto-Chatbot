def send_eye_command(command):
    """Enhanced eye command with better error handling and status tracking"""
    global xiao_serial, XIAO_AVAILABLE
    
    if not XIAO_AVAILABLE or not xiao_serial:
        debug_print(f"Xiao not available, cannot send: {command}")
        return False
        
    try:
        message = f"{command}\n"
        xiao_serial.write(message.encode())
        xiao_serial.flush()
        debug_print(f"👁️  Sent to Xiao: {command}")
        
        # Wait for acknowledgment with timeout
        start_time = time.time()
        while time.time() - start_time < 0.5:  # 500ms timeout
            if xiao_serial.in_waiting > 0:
                response = xiao_serial.readline().decode().strip()
                if response:
                    debug_print(f"👁️  Xiao response: {response}")
                    
                    # Parse status updates
                    if response.startswith("STATUS:"):
                        parse_eye_status(response)
                    elif response.startswith("ACK:"):
                        return True
                    elif response.startswith("ERROR:"):
                        print(f"❌ Xiao error: {response}")
                        return False
                break
            time.sleep(0.01)
            
        return True
    except Exception as e:
        print(f"❌ Failed to send command to Xiao: {e}")
        XIAO_AVAILABLE = False
        return False

def wake_eyes():
