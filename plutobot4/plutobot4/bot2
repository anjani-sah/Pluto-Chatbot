                            fallback_replies = [
                                "Sorry, I'm having trouble processing that right now.",
                                "My brain's a bit foggy at the moment, can you try again?",
                                "Hmm, I didn't quite catch that. What's up?",
                                "Can you rephrase that? I'm not following."
                            ]
                        fallback = np.random.choice(fallback_replies)
                        self.speak_and_interrupt(fallback)
                # Reduced from 0.01 to 0.002 for faster response
                time.sleep(0.002)

