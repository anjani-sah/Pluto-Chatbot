    # ---------------- Memory Helpers ----------------
    def _load_memory(self):
        if not os.path.exists(MEMORY_PATH):
            base = {"preferences": {}, "facts": {}}
            with open(MEMORY_PATH, "w", encoding="utf-8") as f:
                json.dump(base, f, ensure_ascii=False, indent=2)
            return base
        try:
            with open(MEMORY_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {"preferences": {}, "facts": {}}

    def _save_memory(self):
        try:
            tmp = MEMORY_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.memory, f, ensure_ascii=False, indent=2)
            os.replace(tmp, MEMORY_PATH)
        except Exception as e:
            print(f"[memory] save failed: {e}")

    def remember_preference(self, category, value):
        category = category.strip().lower()
        value = value.strip()
        if not category or not value:
            return False
        self.memory.setdefault("preferences", {})[category] = value
        self._save_memory()
        return True

    def recall_preference(self, category):
        prefs = self.memory.get("preferences", {})
        if category in prefs:
            return prefs[category]
        # fuzzy fallback
        best = None
        best_ratio = 0
        for k in prefs:
            r = SequenceMatcher(None, category, k).ratio()
            if r > best_ratio:
                best_ratio = r
                best = k
        if best_ratio >= 0.6:
            return prefs[best]
        return None

    def add_history(self, role, content):
        now = time.time()
        self.recent_history.append((now, role, content))
        self.prune_history()

    def prune_history(self):
        now = time.time()
        self.recent_history = [h for h in self.recent_history if now - h[0] <= MAX_RECENT_HISTORY_SECONDS]
        if len(self.recent_history) > MAX_RECENT_ITEMS:
            self.recent_history = self.recent_history[-MAX_RECENT_ITEMS:]

    def build_context_messages(self, user_text):
        msgs = [system_prompt]
        prefs = self.memory.get("preferences", {})
        if prefs:
            prefs_str = ", ".join(f"{k}: {v}" for k, v in prefs.items())
            msgs.append({"role": "system", "content": f"Known user preferences: {prefs_str}. Use them casually in answers if relevant."})
        # recent conversation (skip if too long)
        for ts, role, content in self.recent_history[-8:]:
            msgs.append({"role": role, "content": content})
        msgs.append({"role": "user", "content": user_text})
        return msgs

    def parse_memory_intent(self, text):
        # Remember pattern
        m = re.match(r"^(?:remember\s+)?my\s+favorite\s+(.+?)\s+is\s+(.+)$", text)
        if m:
            cat = m.group(1).strip()
            val = m.group(2).strip()
            return ("store", cat, val)
        # Recall pattern
        m2 = re.match(r"^what(?:'s| is)?\s+my\s+favorite\s+(.+?)\??$", text)
        if m2:
            cat = m2.group(1).strip()
            return ("recall", cat, None)
        return (None, None, None)

    # --------------- Queue Management for Speed ---------------
    def clear_stale_audio_segments(self):
        """Clear old audio segments to reduce processing lag"""
        cleared_count = 0
        with self.segment_queue_lock:
            try:
                while not self.segment_queue.empty():
                    try:
                        self.segment_queue.get_nowait()
                        cleared_count += 1
                    except queue.Empty:
                        break
            except Exception as e:
                debug_print(f"Error clearing segments: {e}")
        
        if cleared_count > 0:
            self.total_segments_cleared += cleared_count
            debug_print(f"⚡ Cleared {cleared_count} stale audio segments (total: {self.total_segments_cleared})")
        return cleared_count

    def clear_old_inputs(self, keep_latest=True):
        """Clear input queue except optionally the most recent item"""
        items = []
        cleared_count = 0
        
        with self.input_queue_lock:
            try:
                # Collect all items
                while not self.input_queue.empty():
                    try:
                        item = self.input_queue.get_nowait()
                        items.append(item)
                    except queue.Empty:
                        break
                
                # Keep only the latest if requested
                if keep_latest and items:
                    try:
                        self.input_queue.put_nowait(items[-1])  # Put back the most recent
                        cleared_count = len(items) - 1
                    except queue.Full:
                        # If queue is full, just keep the count accurate
                        cleared_count = len(items)
                        debug_print("⚠️  Input queue full, couldn't put back latest item")
                else:
                    cleared_count = len(items)
            except Exception as e:
                debug_print(f"Error clearing inputs: {e}")
        
        if cleared_count > 0:
            self.total_inputs_cleared += cleared_count
            debug_print(f"⚡ Cleared {cleared_count} old input commands (total: {self.total_inputs_cleared})")
        return cleared_count

    def ultra_fast_queue_cleanup(self):
        """Ultra-aggressive queue cleanup for maximum responsiveness"""
        segments_cleared = 0
        inputs_processed = 0
        
        try:
            # Clear ALL segments when new input arrives
            with self.segment_queue_lock:
                while not self.segment_queue.empty():
                    try:
                        self.segment_queue.get_nowait()
                        segments_cleared += 1
                    except queue.Empty:
                        break
            
            # Keep only the absolute latest input
            inputs = []
            with self.input_queue_lock:
                while not self.input_queue.empty():
                    try:
                        inputs.append(self.input_queue.get_nowait())
                        inputs_processed += 1
                    except queue.Empty:
                        break
                
                if inputs:
                    try:
                        # Only keep the very last input
                        self.input_queue.put_nowait(inputs[-1])
                    except queue.Full:
                        debug_print("⚠️  Could not put back latest input - queue full")
                        # In this case, we've cleared everything, which is still beneficial
            
            if inputs_processed > 1 or segments_cleared > 0:
                debug_print(f"⚡ Ultra-fast cleanup: kept 1/{inputs_processed} inputs, cleared {segments_cleared} segments")
            
            # More frequent garbage collection for memory optimization
            if segments_cleared > 5:
                gc.collect()
                
        except Exception as e:
            debug_print(f"Error in ultra_fast_queue_cleanup: {e}")

    def smart_queue_cleanup(self):
        """Intelligent queue cleanup when bot is busy"""
        try:
            # Clear segments when speaking to reduce backlog
            if self.speaking.is_set():
                segments_cleared = self.clear_stale_audio_segments()
                if segments_cleared > 0:
                    debug_print(f"🗣️  Cleared {segments_cleared} segments while speaking")
            
            # More aggressive queue clearing for better responsiveness
            input_size = self.input_queue.qsize()
            if input_size > 1:
                inputs_cleared = self.clear_old_inputs(keep_latest=True)
                if inputs_cleared > 0:
                    debug_print(f"🧹 Smart cleanup: cleared {inputs_cleared} old inputs")
            
            # Force garbage collection periodically for memory optimization
            gc.collect()
            
        except Exception as e:
            debug_print(f"Error in smart_queue_cleanup: {e}")

